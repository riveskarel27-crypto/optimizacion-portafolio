#####################################################
# Análisis de acciones
#####################################################

# ------------------------------------------------------
# Creamos la base de datos en la que estamos trabajando 
# ------------------------------------------------------
create database acciones;

# -----------------------------------------
# Indicamos que es la base que vamos a usar
# ----------------------------------------- 
use acciones;

# -----------------------------
# Vemos los datos de cada tabla
# ----------------------------- 
select * from lmt;
select * from bmy;
select * from stt;

# ---------------------------------------------------------------
# Modificamos la columna de fecha para que se guarden como fechas
# ---------------------------------------------------------------
ALTER TABLE lmt MODIFY Date DATE;
ALTER TABLE bmy MODIFY Date DATE;
ALTER TABLE stt MODIFY Date DATE;

# ----------------
# Primer consulta 
# ----------------
SELECT 
	l.Date, 
	ROUND(l.Close, 2) AS LMT_Close, 
	ROUND(b.Close, 2) AS BMY_Close, 
	ROUND(s.Close, 2) AS STT_Close
FROM lmt l
INNER JOIN bmy b ON l.Date = b.Date
INNER JOIN stt s ON l.Date = s.Date
WHERE l.Date BETWEEN '2024-01-01' AND '2024-12-31'
ORDER BY l.Date ASC;

# -----------------
# Segunda consulta
# -----------------

SELECT 
    DATE_FORMAT(l.Date, '%Y-%m') AS Mes,
    ROUND(AVG(l.Close), 2) AS LMT_Avg,
    ROUND(AVG(b.Close), 2) AS BMY_Avg,
    ROUND(AVG(s.Close), 2) AS STT_Avg
FROM lmt l
INNER JOIN bmy b ON l.Date = b.Date
INNER JOIN stt s ON l.Date = s.Date
GROUP BY DATE_FORMAT(l.Date, '%Y-%m')
ORDER BY Mes ASC;

# -----------------
# tercera consulta
# -----------------
SELECT 'LMT' AS Ticker, MIN(Low) AS Minimo, MAX(High) AS Maximo, AVG(Volume) AS Vol_Promedio FROM lmt
UNION ALL
SELECT 'BMY' AS Ticker, MIN(Low) AS Minimo, MAX(High) AS Maximo, AVG(Volume) AS Vol_Promedio FROM bmy
UNION ALL
SELECT 'STT' AS Ticker, MIN(Low) AS Minimo, MAX(High) AS Maximo, AVG(Volume) AS Vol_Promedio FROM stt;
